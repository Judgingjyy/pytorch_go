    "# L(x,y) = x^4 - 2*x^2 + y^2  (原点附近有鞍点结构)\n",
    "# 更直观：Rosenbrock-like 表面\n",
    "def loss_fn(x, y):\n",
    "    \"\"\"简单的鞍点损失函数：x方向有双井结构，y方向是抛物线\"\"\"\n",
    "    return x**4 - 2*x**2 + x + y**2\n",
    "\n",
    "def grad_fn(x, y):\n",
    "    \"\"\"梯度\"\"\"\n",
    "    return np.array([4*x**3 - 4*x + 1, 2*y])\n",
    "\n",
    "# ── 初始化 ──\n",
    "start = np.array([2.0, 2.0])   # 起始点\n",
    "lr = 0.05\n",
    "n_steps = 80\n",
    "\n",
    "# ── 普通 SGD ──\n",
    "pos_sgd = start.copy()\n",
    "path_sgd = [pos_sgd.copy()]\n",
    "for _ in range(n_steps):\n",
    "    g = grad_fn(*pos_sgd)\n",
    "    pos_sgd = pos_sgd - lr * g\n",
    "    path_sgd.append(pos_sgd.copy())\n",
    "path_sgd = np.array(path_sgd)\n",
    "\n",
    "# ── SGD + Momentum ──\n",
    "momentum = 0.9\n",
    "pos_mom = start.copy()\n",
    "m = np.zeros(2)\n",
    "path_mom = [pos_mom.copy()]\n",
    "for _ in range(n_steps):\n",
    "    g = grad_fn(*pos_mom)\n",
    "    m = momentum * m - lr * g\n",
    "    pos_mom = pos_mom + m\n",
    "    path_mom.append(pos_mom.copy())\n",
    "path_mom = np.array(path_mom)\n",
