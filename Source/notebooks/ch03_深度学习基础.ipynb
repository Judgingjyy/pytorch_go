   "source": [
    "# ═══════════════════════════════════════════\n",
    "# 代码演示 3：从零实现 Adam 优化器\n",
    "# 逐行展示 Adam 的内部运作\n",
    "# ═══════════════════════════════════════════\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "class AdamFromScratch:\n",
    "    \"\"\"从零实现Adam优化器，与PyTorch的torch.optim.Adam完全对应\"\"\"\n",
    "    def __init__(self, params, lr=0.001, betas=(0.9, 0.999), eps=1e-8):\n",
    "        self.params = list(params)\n",
    "        self.lr = lr\n",
    "        self.beta1, self.beta2 = betas\n",
    "        self.eps = eps\n",
    "        self.t = 0  # 时间步\n",
    "        # 为每个参数初始化 m 和 v\n",
    "        self.m = [torch.zeros_like(p) for p in self.params]\n",
    "        self.v = [torch.zeros_like(p) for p in self.params]\n",
    "\n",
    "    def step(self):\n",
    "        self.t += 1\n",
    "        with torch.no_grad():\n",
    "            for i, p in enumerate(self.params):\n",
    "                if p.grad is None:\n",
    "                    continue\n",
    "                g = p.grad\n",
    "                # (1) 更新一阶矩（动量）\n",
    "                self.m[i] = self.beta1 * self.m[i] + (1 - self.beta1) * g\n",
    "                # (2) 更新二阶矩（自适应学习率）\n",
    "                self.v[i] = self.beta2 * self.v[i] + (1 - self.beta2) * g * g\n",
    "                # (3) 偏差校正\n",
    "                m_hat = self.m[i] / (1 - self.beta1 ** self.t)\n",
    "                v_hat = self.v[i] / (1 - self.beta2 ** self.t)\n",
    "                # (4) 参数更新\n",
    "                p -= self.lr * m_hat / (torch.sqrt(v_hat) + self.eps)\n",
    "\n",
    "    def zero_grad(self):\n",
    "        for p in self.params:\n",
    "            if p.grad is not None:\n",
    "                p.grad.zero_()\n",
    "\n",
    "# ── 测试：用自制Adam vs SGD 在简单回归问题上比较 ──\n",
    "torch.manual_seed(42)\n",
    "\n",
    "# 生成数据：y = 3x + 2 + noise\n",
    "X = torch.randn(200, 1) * 2\n",
    "y_true = 3.0 * X + 2.0\n",
    "y = y_true + torch.randn(200, 1) * 1.5\n",
    "\n",
    "# 线性回归模型\n",
    "model_sgd = nn.Linear(1, 1)\n",
    "model_adam = nn.Linear(1, 1)\n",
    "model_custom = nn.Linear(1, 1)\n",
    "\n",
    "# PyTorch优化器\n",
    "opt_sgd = torch.optim.SGD(model_sgd.parameters(), lr=0.01)\n",
    "opt_adam = torch.optim.Adam(model_adam.parameters(), lr=0.1)\n",
    "\n",
    "# 自制Adam\n",
    "opt_custom = AdamFromScratch(model_custom.parameters(), lr=0.1)\n",
    "\n",
    "loss_fn = nn.MSELoss()\n",
    "n_epochs = 150\n",
    "\n",
    "losses_sgd, losses_adam, losses_custom = [], [], []\n",
    "\n",
    "for epoch in range(n_epochs):\n",
    "    # SGD\n",
    "    opt_sgd.zero_grad()\n",
    "    l_sgd = loss_fn(model_sgd(X), y)\n",
    "    l_sgd.backward()\n",
    "    opt_sgd.step()\n",
    "    losses_sgd.append(l_sgd.item())\n",
    "\n",
    "    # PyTorch Adam\n",
    "    opt_adam.zero_grad()\n",
    "    l_adam = loss_fn(model_adam(X), y)\n",
    "    l_adam.backward()\n",
    "    opt_adam.step()\n",
    "    losses_adam.append(l_adam.item())\n",
    "\n",
    "    # 自制Adam\n",
    "    opt_custom.zero_grad()\n",
    "    l_custom = loss_fn(model_custom(X), y)\n",
    "    l_custom.backward()\n",
    "    opt_custom.step()\n",
    "    losses_custom.append(l_custom.item())\n",
