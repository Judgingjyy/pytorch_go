   "source": [
    "# ═══════════════════════════════════════════\n",
    "# 代码演示 5：Softmax + 交叉熵 vs MSE\n",
    "# 展示为什么分类必须用交叉熵\n",
    "# ═══════════════════════════════════════════\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# ── Softmax 函数的手动实现 ──\n",
    "def softmax_manual(logits):\n",
    "    \"\"\"手动实现softmax\"\"\"\n",
    "    exp_logits = np.exp(logits - np.max(logits))  # 减去最大值防止溢出\n",
    "    return exp_logits / np.sum(exp_logits)\n",
    "\n",
    "# 演示Softmax\n",
    "logits = np.array([3.0, 1.0, -3.0])\n",
    "probs = softmax_manual(logits)\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"Softmax 演示\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"原始logits:      {logits}\")\n",
    "print(f\"exp(logits):     {np.exp(logits)}\")\n",
    "print(f\"Softmax概率:     {probs}\")\n",
    "print(f\"概率之和:        {np.sum(probs):.4f}\")\n",
    "print()\n",
    "\n",
    "# ── 对比MSE和交叉熵在分类任务上的训练 ──\n",
    "torch.manual_seed(42)\n",
    "\n",
    "# 简单三分类问题\n",
    "class SimpleClassifier(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.fc = nn.Linear(2, 3)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.fc(x)\n",
    "\n",
    "# 生成三类数据（3个高斯分布）\n",
    "centers = [(-3, -3), (3, 3), (3, -3)]\n",
    "X_list, y_list = [], []\n",
    "for i, (cx, cy) in enumerate(centers):\n",
    "    X_list.append(np.random.randn(300, 2) * 1.5 + np.array([cx, cy]))\n",
    "    y_list.append(np.full(300, i))\n",
    "X_data = np.vstack(X_list).astype(np.float32)\n",
    "y_data = np.hstack(y_list).astype(np.int64)\n",
    "\n",
    "X_tensor = torch.from_numpy(X_data)\n",
    "y_tensor = torch.from_numpy(y_data)\n",
    "\n",
    "# ── 用交叉熵训练 ──\n",
    "model_ce = SimpleClassifier()\n",
    "opt_ce = torch.optim.SGD(model_ce.parameters(), lr=0.1)\n",
    "ce_losses = []\n",
    "\n",
    "for epoch in range(100):\n",
    "    opt_ce.zero_grad()\n",
    "    logits = model_ce(X_tensor)\n",
    "    loss = F.cross_entropy(logits, y_tensor)  # PyTorch的交叉熵内置了softmax\n",
    "    loss.backward()\n",
    "    opt_ce.step()\n",
    "    ce_losses.append(loss.item())\n",
    "\n",
    "# ── 用MSE训练 ──\n",
    "model_mse = SimpleClassifier()\n",
    "opt_mse = torch.optim.SGD(model_mse.parameters(), lr=0.1)\n",
    "mse_losses = []\n",
    "\n",
    "for epoch in range(100):\n",
    "    opt_mse.zero_grad()\n",
    "    logits = model_mse(X_tensor)\n",
    "    probs = F.softmax(logits, dim=1)\n",
    "    targets = F.one_hot(y_tensor, num_classes=3).float()\n",
    "    loss = F.mse_loss(probs, targets)\n",
    "    loss.backward()\n",
    "    opt_mse.step()\n",
    "    mse_losses.append(loss.item())\n",
    "\n",
    "# ── 可视化 ──\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# 损失曲线对比\n",
    "ax = axes[0]\n",
    "ax.plot(ce_losses, label='交叉熵 (Cross-Entropy)', linewidth=2, color='#2E86AB')\n",
    "ax.plot(mse_losses, label='均方误差 (MSE)', linewidth=2, color='#A23B72')\n",
    "ax.set_xlabel('Epoch', fontsize=12)\n",
    "ax.set_ylabel('损失', fontsize=12)\n",
    "ax.set_title('交叉熵 vs MSE 在分类任务上的训练曲线', fontsize=13, fontweight='bold')\n",
    "ax.legend(fontsize=11)\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# 准确率对比\n",
    "ax = axes[1]\n",
    "with torch.no_grad():\n",
    "    pred_ce = model_ce(X_tensor).argmax(dim=1)\n",
    "    pred_mse = model_mse(X_tensor).argmax(dim=1)\n",
    "    acc_ce = (pred_ce == y_tensor).float().mean().item()\n",
    "    acc_mse = (pred_mse == y_tensor).float().mean().item()\n",
    "\n",
    "bars = ax.bar(['交叉熵', '均方误差 MSE'], [acc_ce, acc_mse],\n",
    "              color=['#2E86AB', '#A23B72'], width=0.4, edgecolor='black')\n",
    "ax.set_ylabel('准确率', fontsize=12)\n",
    "ax.set_title('训练100轮后的分类准确率对比', fontsize=13, fontweight='bold')\n",
    "ax.set_ylim(0, 1.05)\n",
    "\n",
    "for bar, acc in zip(bars, [acc_ce, acc_mse]):\n",
    "    ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.02,\n",
    "            f'{acc:.2%}', ha='center', fontsize=13, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('ch03_softmax_ce_vs_mse.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\n训练结果:\")\n",
    "print(f\"  交叉熵 - 最终损失: {ce_losses[-1]:.6f}, 准确率: {acc_ce:.2%}\")\n",
    "print(f\"  MSE    - 最终损失: {mse_losses[-1]:.6f}, 准确率: {acc_mse:.2%}\")\n",
    "print(f\"\\n结论：分类任务请务必使用交叉熵损失！MSE会让优化停滞。\")"
   ],
