    "# ═══════════════════════════════════════════\n",
    "# 代码演示 6：Batch Normalization 层演示\n",
    "# 展示BN的前向传播和train/eval模式差异\n",
    "# ═══════════════════════════════════════════\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "# ── 构造一个简单的BN实验 ──\n",
    "torch.manual_seed(42)\n",
    "batch_size = 32\n",
    "features = 10\n",
    "\n",
    "# 创建一个有偏的输入分布（非零均值，非单位方差）\n",
    "x = torch.randn(batch_size, features) * 3.0 + 5.0  # 均值≈5, 标准差≈3\n",
    "\n",
    "# PyTorch BN层\n",
    "bn = nn.BatchNorm1d(features, eps=1e-5, momentum=0.1)\n",
    "\n",
    "# ── 训练模式下的BN ──\n",
    "bn.train()\n",
    "y_train = bn(x)\n",
    "\n",
    "# 手动计算BN来验证\n",
    "mu_batch = x.mean(dim=0, keepdim=True)\n",
    "var_batch = x.var(dim=0, unbiased=False, keepdim=True)\n",
    "x_hat_manual = (x - mu_batch) / torch.sqrt(var_batch + 1e-5)\n",
    "y_manual = bn.weight * x_hat_manual + bn.bias\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"Batch Normalization 训练模式验证\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"输入均值范围: [{x.mean(dim=0).min().item():.2f}, {x.mean(dim=0).max().item():.2f}]\")\n",
    "print(f\"输入标准差范围: [{x.std(dim=0).min().item():.2f}, {x.std(dim=0).max().item():.2f}]\")\n",
    "print(f\"\\nBN输出均值: {y_train.mean().item():.6f}\")\n",
    "print(f\"BN输出标准差: {y_train.std().item():.6f}\")\n",
    "print(f\"\\nPyTorch BN 与手动计算是否一致: {torch.allclose(y_train, y_manual, atol=1e-5)}\")\n",
    "print(f\"\\nBN内部统计量:\")\n",
    "print(f\"  running_mean (应初始化为0): {bn.running_mean[:3].detach().numpy()}\")\n",
    "\n",
    "# ── 多步训练展示running_mean的更新 ──\n",
    "bn2 = nn.BatchNorm1d(features, eps=1e-5, momentum=0.1)\n",
    "bn2.train()\n",
    "\n",
    "running_means = []\n",
    "for step in range(20):\n",
    "    x_step = torch.randn(batch_size, features) * 2.0 + 3.0  # 均值≈3\n",
    "    _ = bn2(x_step)\n",
    "    running_means.append(bn2.running_mean[0].item())\n",
    "\n",
    "# ── train vs eval 模式对比 ──\n",
    "x_test = torch.randn(8, features) * 4.0 - 1.0  # 测试数据，分布不同\n",
    "\n",
    "bn3 = nn.BatchNorm1d(features, eps=1e-5, momentum=0.1)\n",
    "# 先训练几步让running stats累积\n",
    "bn3.train()\n",
    "for _ in range(50):\n",
    "    _ = bn3(torch.randn(16, features) * 2.0 + 3.0)\n",
    "\n",
    "# 对比train和eval模式\n",
    "bn3.train()\n",
    "y_train_mode = bn3(x_test)\n",
    "bn3.eval()\n",
    "y_eval_mode = bn3(x_test)\n",
    "\n",
    "# ── 可视化 ──\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# 图1：BN前后的分布对比\n",
    "ax = axes[0, 0]\n",
    "ax.hist(x[:, 0].numpy(), bins=20, alpha=0.5, label='BN前', color='red', density=True)\n",
    "ax.hist(y_train[:, 0].detach().numpy(), bins=20, alpha=0.5, label='BN后', color='blue', density=True)\n",
    "ax.set_xlabel('值', fontsize=11)\n",
    "ax.set_ylabel('密度', fontsize=11)\n",
    "ax.set_title('BN前后第一个特征的分布变化', fontsize=12, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
    "ax.axvline(x=0, color='gray', linestyle='--', alpha=0.5)\n",
    "\n",
    "# 图2：running_mean的更新过程\n",
    "ax = axes[0, 1]\n",
    "ax.plot(running_means, 'b-o', markersize=4, linewidth=1.5)\n",
    "ax.axhline(y=3.0, color='red', linestyle='--', label='真实均值=3.0')\n",
    "ax.set_xlabel('步骤', fontsize=11)\n",
    "ax.set_ylabel('running_mean[0]', fontsize=11)\n",
    "ax.set_title('BN running_mean 的移动平均更新', fontsize=12, fontweight='bold')\n",
    "ax.legend(fontsize=10)\n",
